<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PDFToys.App.ViewModels"
             x:Class="PDFToys.App.Views.AboutView"
             x:DataType="vm:AboutViewModel">
	<Grid Margin="24">
		<StackPanel Spacing="12">
			<Button Content="← Back to Hub"
                    Command="{Binding GoBackCommand}"
                    Background="Transparent"
                    Foreground="LightSkyBlue"
                    HorizontalAlignment="Left" />
			<TextBlock Text="{Binding Title}"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center" />
			<TextBlock Text="{Binding VersionText, StringFormat=Version {0}}"
                       HorizontalAlignment="Center" />
			<TextBlock Text="{Binding LicenseSummary}"
                       TextWrapping="Wrap" />
			<TextBlock Text="{Binding NoticeSummary}"
                       TextWrapping="Wrap" />
		</StackPanel>
	</Grid>
</UserControl>
