<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:PDFToys.App.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="PDFToys.App.Views.MergeView"
             x:DataType="vm:MergeViewModel">
	<Border Padding="24">
		<StackPanel HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Spacing="20">
			<Button Content="← Back to Hub" Command="{Binding GoBackCommand}" Background="Transparent" Foreground="LightSkyBlue" Cursor="Hand" Margin="0,0,0,15" HorizontalAlignment="Left" />
			<TextBlock Text="{Binding StatusMessage}"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       HorizontalAlignment="Stretch" />

			<Button Content="1. Select PDFs to Merge"
                    Command="{Binding AddFilesCommand}"
                    HorizontalAlignment="Stretch"
                    Padding="12,8" />

			<StackPanel Spacing="6">
				<TextBlock Text="SELECTED"
                           FontWeight="SemiBold" />
				<Grid ColumnDefinitions="*,Auto"
					  ColumnSpacing="12">
					<ListBox Grid.Column="0"
							 x:Name="MergeItemsListBox"
							 ItemsSource="{Binding MergeItems}"
							 DragDrop.AllowDrop="True"
							 MinWidth="220"
							 MaxHeight="220">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<Grid ColumnDefinitions="Auto,*,Auto"
									  Background="Transparent"
									  Margin="4,2"
									  Cursor="Hand">
									<TextBlock Grid.Column="0"
											   Text="≡"
											   FontSize="20"
											   FontWeight="Bold"
											   Foreground="Gray"
											   Margin="0,0,10,0"
											   Cursor="SizeAll"
											   ToolTip.Tip="Drag to reorder"
											   VerticalAlignment="Center" />
									<TextBlock Grid.Column="1"
											   Text="{Binding FileName}"
											   TextWrapping="Wrap"
											   VerticalAlignment="Center" />
								</Grid>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</Grid>
			</StackPanel>

			<Button Content="2. Execute Merge"
                    Command="{Binding ExecuteMergeCommand}"
                    HorizontalAlignment="Stretch"
                    Padding="12,8" />
		</StackPanel>
	</Border>
</UserControl>

